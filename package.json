{
  "name": "blackboard",
  "version": "0.8.0",
  "description": "Agent 外置黑板：自由探索，持续记录逻辑节点、关系、当前游标与轨迹",
  "type": "module",
  "bin": {
    "blackboard": "./bin/blackboard.js"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "public/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "serve": "node bin/blackboard.js serve",
    "export": "node bin/blackboard.js export",
    "check:types": "tsc --noEmit",
    "check:publish": "node scripts/check-publication.mjs",
    "evaluate:recovery": "node scripts/evaluate-recovery.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:full": "node scripts/benchmark.mjs --full",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:exports:text": "node scripts/verify-text-exports.mjs",
    "verify:exports:sarif": "node scripts/verify-sarif.mjs",
    "verify:exports": "npm run verify:exports:text && npm run verify:exports:sarif"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.60.0",
    "markdown-it": "15.0.3",
    "mermaid": "11.12.0",
    "playwright": "1.64.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
