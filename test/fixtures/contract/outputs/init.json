{
  "command": "init",
  "cases": [
    {
      "board": null,
      "args": [
        "init",
        "--title",
        "New board",
        "--cwd",
        "<board>",
        "--json"
      ],
      "exitCode": 0,
      "output": {
        "schema": "blackboard.init.v1",
        "cwd": "<root>/board",
        "board": "<root>/board/.blackboard",
        "title": "New board",
        "session": "<session-id>"
      },
      "events": [
        {
          "eventVersion": 1,
          "eventId": "<event-id>",
          "op": "meta",
          "set": {
            "title": "New board"
          }
        }
      ]
    }
  ]
}
